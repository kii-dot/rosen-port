{
  "extends": "./tsconfig.novite.json",
  "compilerOptions": {
    "target": "esnext",
    "outDir": "dist",
    "rootDir": "./"
  },
  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node"
  },
  "tsc-alias": {
    "resolveFullPaths": true,
    "verbose": false
  },
  "include": ["src", "./tokens.json"]
}
