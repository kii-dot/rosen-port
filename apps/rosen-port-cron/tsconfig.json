{
  "extends": "./tsconfig.novite.json",
  "compilerOptions": {
    "target": "esnext",
    "outDir": "dist",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "rootDir": "./"
  },
  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node"
  },
  "tsc-alias": {
    "resolveFullPaths": true,
    "verbose": false
  },
  "include": [
    "src",
    "src/assets/rosenTokens.json",
    "src/assets/rosenLaunchConfig.json"
  ]
}
