{
  "name": "rosen-port-cron",
  "version": "0.1.0",
  "description": "Rosen Port Cron",
  "keywords": [
    "rosen-port",
    "backend"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!**/__tests__/**/*"
  ],
  "type": "module",
  "scripts": {
    "prettify": "prettier --write . --ignore-path .gitignore",
    "lint": "eslint --fix . && npm run prettify",
    "build": "rimraf ./dist && tsc && tsc-alias",
    "start": "node --experimental-specifier-resolution=node dist/src/index.js",
    "type-check": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@rosen-port/chains": "^0.1.0",
    "@rosen-port/db": "^0.1.0",
    "@rosen-port/ergo-explorer-node": "^0.1.0",
    "@rosen-port/errors": "^0.1.0",
    "@rosen-port/multi-chain-payment": "^0.1.0",
    "@rosen/sdk": "^0.1.0",
    "dotenv": "^16.3.1",
    "node-cron": "^3.0.3",
    "pino": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.11",
    "@types/node-cron": "^3.0.11",
    "pino-pretty": "^11.0.0"
  }
}
