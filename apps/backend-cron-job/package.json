{
  "name": "rosen-port-backend",
  "version": "0.1.0",
  "description": "Rosen Port backend",
  "keywords": [
    "rosen-port",
    "backend"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!**/__tests__/**/*"
  ],
  "type": "module",
  "scripts": {
    "prettify": "prettier --write . --ignore-path .gitignore",
    "lint": "eslint --fix . && npm run prettify",
    "build": "rimraf ./dist && tsc",
    "start": "node --experimental-specifier-resolution=node dist/src/index.js",
    "type-check": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.42.5",
    "dotenv": "^16.3.1",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/node-cron": "^3.0.11"
  }
}
